.program linein_rx
.side_set 2

.wrap_target
                    ;          /--- LRCLK
                    ;          |/-- BCLK
    set x, 14           side 0b01 

left_loop:
    in  pins,1          side 0b11 
    jmp x-- left_loop   side 0b01 [1]

    in  pins,1          side 0b10 
    set x,14            side 0b00 [1]

right_loop:
    in  pins,1          side 0b10 
    jmp x-- right_loop  side 0b00 [1]

    in  pins,1          side 0b11

    push block          side 0b01

.wrap

% c-sdk {
static inline void linein_rx_program_init(PIO pio, uint sm, uint offset,
                                          uint data_pin, uint clock_pin_base, float clkdiv)
{
    pio_gpio_init(pio, data_pin);
    pio_gpio_init(pio, clock_pin_base);
    pio_gpio_init(pio, clock_pin_base + 1);

    pio_sm_config c = linein_rx_program_get_default_config(offset);
    sm_config_set_in_pins(&c, data_pin);
    sm_config_set_sideset_pins(&c, clock_pin_base);

    // Only transmitting, so make the FIFO as large as possible to give max time to IRQ handler to restart DMA
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_RX);

    sm_config_set_in_shift(&c, false, false, 32);

    sm_config_set_clkdiv(&c, clkdiv);

    // Clocks are outputs, data pin is output
    pio_sm_set_consecutive_pindirs(pio, sm, clock_pin_base, 2, true);
    pio_sm_set_consecutive_pindirs(pio, sm, data_pin, 1, false);

    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_enabled(pio, sm, true);
}

%}
