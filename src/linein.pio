; I2S Receive
; Reads 1 bit every 2 cycles (2*16 bit words every 64 cycles)
; Word select (LRCLK) transitions before LSB is read, as per I2S standard
;
; Clock division:
; 270MHz sys clock, 32kHz capture -> 270000000 / (32000 * 64) = 131.8359375 -> 131 and 214/256
; 252MHz sys clock, 32kHz capture -> 252000000 / (32000 * 64) = 123.046875  -> 123 and 12/256
; 270MHz sys clock, 48kHz capture -> 270000000 / (48000 * 64) = 87.890625   -> 87 and 228/256
; 252MHz sys clock, 48kHz capture -> 252000000 / (48000 * 64) = 82.03125    -> 82 and 176/256

.program linein_rx
.side_set 2

.wrap_target
 ;                             /--- BCLK
 ;                             |/-- LRCLK
    set x, 13           side 0b01

right_loop:
    in  pins,1          side 0b11
    jmp x-- right_loop  side 0b01

    in  pins,1          side 0b11
    nop                 side 0b00   ; LRCLK transitions on BCLK falling edge

    in  pins,1          side 0b10   ; Read right LSB

    set x,13            side 0b00
left_loop:
    in  pins,1          side 0b10
    jmp x-- left_loop   side 0b00

    in  pins,1          side 0b10
    nop                 side 0b01   ; LRCLK transitions on BCLK falling edge

    in  pins,1          side 0b11   ; Read left LSB and autopush

.wrap

% c-sdk {
static inline void linein_rx_program_init(PIO pio, uint sm, uint offset,
                                          uint data_pin, uint clock_pin_base, float clkdiv)
{
    pio_gpio_init(pio, data_pin);
    pio_gpio_init(pio, clock_pin_base);
    pio_gpio_init(pio, clock_pin_base + 1);

    pio_sm_config c = linein_rx_program_get_default_config(offset);
    sm_config_set_in_pins(&c, data_pin);
    sm_config_set_sideset_pins(&c, clock_pin_base);

    // Only transmitting, so make the FIFO as large as possible to give max time to IRQ handler to restart DMA
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_RX);

    sm_config_set_in_shift(&c, false, true, 32);   // shift left, autopush, push on 32 bits

    sm_config_set_clkdiv(&c, clkdiv);

    // Clocks are outputs, data pin is output
    pio_sm_set_consecutive_pindirs(pio, sm, clock_pin_base, 2, true);
    pio_sm_set_consecutive_pindirs(pio, sm, data_pin, 1, false);

    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_enabled(pio, sm, true);
}

%}
